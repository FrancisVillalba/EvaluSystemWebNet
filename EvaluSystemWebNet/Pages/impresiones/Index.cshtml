@page
@model EvaluSystemWebNet.Pages.impresiones.IndexModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Impresiones";
    ViewData["ActiveMenu"] = "impresiones";
    ViewData["ShellClass"] = "reports-shell";
}

@section Styles {
    <link rel="stylesheet" href="~/css/control.css" asp-append-version="true" />
}

<section class="reports-main">
    <header class="reports-header">
        <div>
            <p class="eyebrow">Impresiones</p>
            <h1>Archivos para impresion</h1>
            <p>Descarga los archivos de diseño agrupados por maquina.</p>
        </div>
        <button id="refresh-print-files" class="admin-primary" type="button">Actualizar</button>
    </header>

    <div class="reports-workspace">
        <aside id="machine-menu" class="reports-modules" aria-label="Maquinas"></aside>

        <section class="reports-panel">
            <div class="reports-panel-header">
                <div>
                    <h2 id="machine-title">Maquina</h2>
                    <p id="machine-help">Archivos cargados para impresion.</p>
                </div>
                <div class="panel-heading-actions">
                    <span id="machine-count" class="delivery-route-count">0 archivos</span>
                    <button id="refresh-print-files-panel" class="admin-primary" type="button">Actualizar</button>
                </div>
            </div>

            <div class="reports-filters control-filters">
                <label for="print-date-from">
                    Fecha desde
                    <input id="print-date-from" type="date" />
                </label>
                <label for="print-date-to">
                    Fecha hasta
                    <input id="print-date-to" type="date" />
                </label>
                <label for="print-search">
                    Buscar
                    <input id="print-search" type="search" placeholder="Pedido, cliente o producto" />
                </label>
            </div>

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Vendedor</th>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th class="print-file-column">Archivo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="print-files-body"></tbody>
                </table>
            </div>
        </section>
    </div>
</section>

<div id="return-modal" class="control-modal" hidden>
    <form id="return-form" class="control-modal-card">
        <header>
            <div>
                <span>Devolver a carga</span>
                <h2 id="return-title">Pedido</h2>
            </div>
            <button id="return-close" class="control-modal-close" type="button" aria-label="Cerrar">&times;</button>
        </header>
        <label for="return-comment">
            Comentario
            <textarea id="return-comment" maxlength="500" required placeholder="Indica el motivo de la devolución"></textarea>
        </label>
        <footer>
            <button id="return-cancel" class="admin-secondary" type="button">Cancelar</button>
            <button class="admin-danger" type="submit">Devolver a carga</button>
        </footer>
    </form>
</div>
@section Scripts {
    <script>
        const machineMenu = document.getElementById("machine-menu");
        const machineTitle = document.getElementById("machine-title");
        const machineCount = document.getElementById("machine-count");
        const tableBody = document.getElementById("print-files-body");
        const search = document.getElementById("print-search");
        const dateFrom = document.getElementById("print-date-from");
        const dateTo = document.getElementById("print-date-to");
        const returnModal = document.getElementById("return-modal");
        const returnForm = document.getElementById("return-form");
        const returnTitle = document.getElementById("return-title");
        const returnComment = document.getElementById("return-comment");

        let files = [];
        let machines = [];
        let selectedMachine = "";
        let returnDetailId = null;
        const downloadedFileIds = new Set();

        function markFileAsDownloaded(id) {
            downloadedFileIds.add(String(id));
            const button = tableBody.querySelector(`[data-download="${CSS.escape(String(id))}"]`);
            if (button) {
                button.classList.add("is-downloaded");
                button.title = "Archivo descargado";
                button.setAttribute("aria-label", "Archivo descargado");
            }
        }
        function localDateValue(date = new Date()) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, "0");
            const day = String(date.getDate()).padStart(2, "0");
            return `${year}-${month}-${day}`;
        }

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                "\"": "&quot;",
                "'": "&#039;"
            })[character]);
        }

        function normalized(value) {
            return String(value || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
        }

        function formatDate(value) {
            return value ? new Date(value).toLocaleDateString("es-PY") : "-";
        }

        function formatQuantity(value) {
            return Number(value || 0).toLocaleString("es-PY", { maximumFractionDigits: 2 });
        }

        function shortPersonName(value) {
            const parts = String(value || "").trim().split(/\s+/).filter(Boolean);
            if (parts.length >= 3) {
                return `${parts[0]} ${parts[2]}`;
            }

            return parts.length > 1 ? `${parts[0]} ${parts[1]}` : parts[0] || "";
        }

        function sellerColorClass(value) {
            const text = String(value || "").trim().toLowerCase();
            let hash = 0;

            for (let index = 0; index < text.length; index += 1) {
                hash = ((hash << 5) - hash + text.charCodeAt(index)) | 0;
            }

            return `seller-color-${Math.abs(hash) % 7}`;
        }

        function getMachineGroups() {
            const groups = new Map(machines.map(machine => [String(machine.id), {
                id: String(machine.id),
                name: machine.nombre || `Maquina ${machine.id}`,
                count: 0
            }]));
            files.forEach(item => {
                const key = String(item.tipoMaquinaId);
                const current = groups.get(key) || { id: key, name: item.tipoMaquina || "Sin maquina", count: 0 };
                current.name = item.tipoMaquina || current.name;
                current.count += 1;
                groups.set(key, current);
            });

            return Array.from(groups.values()).sort((a, b) => a.name.localeCompare(b.name));
        }

        function ensureSelectedMachine(machines) {
            if (!machines.length) {
                selectedMachine = "";
                return;
            }

            if (!selectedMachine || !machines.some(machine => machine.id === selectedMachine)) {
                selectedMachine = machines[0].id;
            }
        }

        function filteredFiles() {
            const term = normalized(search.value);
            return selectedMachine
                ? files.filter(item => {
                    if (String(item.tipoMaquinaId) !== selectedMachine) return false;
                    const haystack = [
                        item.pedidoId,
                        item.cliente,
                        item.vendedor,
                        item.producto,
                        item.archivoDisenioNombre,
                        item.tipoMaquina
                    ].join(" ");
                    return !term || normalized(haystack).includes(term);
                })
                : [];
        }

        function renderMachineMenu() {
            const machines = getMachineGroups();
            ensureSelectedMachine(machines);

            machineMenu.innerHTML = machines.length
                ? machines.map(machine => `
                    <button class="${selectedMachine === machine.id ? "active" : ""}" type="button" data-machine="${machine.id}">
                        <span>${escapeHtml(machine.name)}</span><strong class="print-count-badge">${machine.count}</strong>
                    </button>
                `).join("")
                : `<div class="empty-state">No hay maquinas activas.</div>`;
        }

        function renderTable() {
            const rows = filteredFiles();
            const selectedMachineData = getMachineGroups().find(machine => machine.id === selectedMachine);
            machineTitle.textContent = selectedMachineData?.name || "Maquina";
            machineCount.textContent = `${rows.length} archivos`;
            tableBody.innerHTML = rows.length
                ? rows.map(item => `
                    <tr>
                        <td>#${item.pedidoId}</td>
                        <td>${formatDate(item.fechaEntrega || item.fechaCarga)}</td>
                        <td><strong>${escapeHtml(item.cliente)}</strong></td>
                        <td><span class="orders-seller ${sellerColorClass(item.vendedor)}">${escapeHtml(shortPersonName(item.vendedor) || "Sin vendedor")}</span></td>
                        <td>${escapeHtml(item.producto)}</td>
                        <td>${formatQuantity(item.cantidad)}</td>
                        <td class="print-file-column">${escapeHtml(item.archivoDisenioNombre || "Archivo de diseno")}</td>
                        <td>
                            <div class="print-row-actions">
                                <button class="admin-secondary print-icon-button ${downloadedFileIds.has(String(item.detalleId)) ? "is-downloaded" : ""}" type="button" data-download="${item.detalleId}" title="${downloadedFileIds.has(String(item.detalleId)) ? "Archivo descargado" : "Descargar"}" aria-label="${downloadedFileIds.has(String(item.detalleId)) ? "Archivo descargado" : "Descargar"}">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 3v12"></path>
                                        <path d="m7 10 5 5 5-5"></path>
                                        <path d="M5 21h14"></path>
                                    </svg>
                                </button>
                                <button class="admin-primary print-mark-button" type="button" data-print="${item.detalleId}" ${item.impreso ? "disabled" : ""}>Impreso</button>
                                <button class="admin-danger" type="button" data-return="${item.detalleId}" data-return-order="${item.pedidoId}">Devolver</button>
                            </div>
                        </td>
                    </tr>
                `).join("")
                : `<tr><td colspan="8">No hay archivos para los filtros seleccionados.</td></tr>`;
        }

        async function loadFiles() {
            await withAppLoading("Cargando archivos...", async function () {
                const params = new URLSearchParams();
                if (dateFrom.value) {
                    params.set("fechaDesde", dateFrom.value);
                }

                if (dateTo.value) {
                    params.set("fechaHasta", dateTo.value);
                }

                const [filesResponse, machinesResponse] = await Promise.all([
                    fetch(`/api/impresiones?${params.toString()}`),
                    fetch("/api/impresiones/maquinas")
                ]);
                if (!filesResponse.ok || !machinesResponse.ok) {
                    const errorResponse = !filesResponse.ok ? filesResponse : machinesResponse;
                    const error = await errorResponse.json().catch(() => null);
                    showToast(error?.message || "No se pudieron cargar los archivos.", "error");
                    return;
                }

                const result = await filesResponse.json() || [];
                files = result.filter(item => item.impreso !== true);
                const machineResult = await machinesResponse.json() || [];
                machines = machineResult.filter(machine => machine.estado !== false);
                renderMachineMenu();
                renderTable();
            });
        }

        async function downloadFile(id) {
            await withAppLoading("Descargando archivo...", async function () {
                const response = await fetch(`/api/impresiones/${id}/archivo`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo descargar el archivo.", "error");
                    return;
                }

                const blob = await response.blob();
                const disposition = response.headers.get("content-disposition") || "";
                const match = disposition.match(/filename\*=UTF-8''([^;]+)|filename="?([^"]+)"?/i);
                const fileName = match ? decodeURIComponent(match[1] || match[2]) : `archivo-${id}`;
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(link.href);
                markFileAsDownloaded(id);
            });
        }

        async function markPrinted(id) {
            await withAppLoading("Marcando impresion...", async function () {
                const response = await fetch(`/api/impresiones/${id}/marcar-impreso`, { method: "PUT" });
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo marcar como impreso.", "error");
                    return;
                }

                const result = await response.json();
                showToast(result.pedidoCompleto
                    ? "Detalle impreso. El pedido paso a Pendiente envio."
                    : "Detalle marcado como impreso.", "success");
                await loadFiles();
            });
        }

        function openReturnModal(detailId, orderId) {
            returnDetailId = detailId;
            returnTitle.textContent = `Pedido #${orderId} - detalle #${detailId}`;
            returnComment.value = "";
            returnModal.hidden = false;
            returnComment.focus();
        }

        function closeReturnModal() {
            returnModal.hidden = true;
            returnDetailId = null;
            returnComment.value = "";
        }

        async function returnToCarga(id, observacion) {
            await withAppLoading("Devolviendo pedido a carga...", async function () {
                const response = await fetch(`/api/impresiones/${id}/devolver-carga`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ observacion })
                });
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo devolver el pedido a carga.", "error");
                    return;
                }

                showToast("Pedido devuelto a carga con el comentario registrado.", "success");
                closeReturnModal();
                await loadFiles();
            });
        }
        machineMenu.addEventListener("click", event => {
            const button = event.target.closest("[data-machine]");
            if (!button) {
                return;
            }

            selectedMachine = button.dataset.machine || "";
            renderMachineMenu();
            renderTable();
        });

        tableBody.addEventListener("click", event => {
            const button = event.target.closest("[data-download]");
            if (button) {
                downloadFile(button.dataset.download);
                return;
            }

            const printButton = event.target.closest("[data-print]");
            if (printButton) {
                markPrinted(printButton.dataset.print);
                return;
            }

            const returnButton = event.target.closest("[data-return]");
            if (returnButton) {
                openReturnModal(returnButton.dataset.return, returnButton.dataset.returnOrder);
            }
        });

        returnForm.addEventListener("submit", event => {
            event.preventDefault();
            const observacion = returnComment.value.trim();
            if (!observacion) {
                showToast("Debe agregar un comentario para devolver el pedido.", "error");
                returnComment.focus();
                return;
            }

            returnToCarga(returnDetailId, observacion);
        });

        document.getElementById("return-close").addEventListener("click", closeReturnModal);
        document.getElementById("return-cancel").addEventListener("click", closeReturnModal);
        returnModal.addEventListener("click", event => {
            if (event.target === returnModal) closeReturnModal();
        });
        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && !returnModal.hidden) closeReturnModal();
        });

        document.getElementById("refresh-print-files")?.addEventListener("click", loadFiles);
        document.getElementById("refresh-print-files-panel")?.addEventListener("click", loadFiles);
        search.addEventListener("input", renderTable);
        [dateFrom, dateTo].forEach(input => input.addEventListener("change", loadFiles));

        const today = new Date();
        const fiveDaysAgo = new Date();
        fiveDaysAgo.setDate(today.getDate() - 5);
        dateFrom.value = localDateValue(fiveDaysAgo);
        dateTo.value = localDateValue(today);
        loadFiles();
    </script>
}
